# ---------------------------------------------------------------------------
# Haylaz Cafe — ortam değişkenleri
#
# Yerel geliştirme için bu dosyayı ".env" adıyla kopyalayıp doldurun.
# Vercel'de ise aynı değişkenleri Settings › Environment Variables altına girin.
# ---------------------------------------------------------------------------

# Postgres bağlantı adresi.
# Neon kullanıyorsanız "Pooled connection" (havuzlu) adresi tercih edin.
DATABASE_URL=postgresql://kullanici:sifre@host/veritabani?sslmode=require

# Yönetim paneli giriş şifresi. En az 8 karakter; tahmin edilmesi zor olsun.
ADMIN_PASSWORD=

# Oturum çerezini imzalayan gizli anahtar. En az 32 karakter, rastgele olmalı.
# Üretmek için:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Fiyat geçmişinde "kim değiştirdi" sütununda görünecek etiket (isteğe bağlı).
ADMIN_EMAIL=

# Üretimde tarayıcıdan istek kabul edilecek adresler (virgülle ayrılmış).
# Vercel'de sitenizin adresini yazın. Boş bırakılırsa farklı alan adlarından
# gelen tarayıcı istekleri reddedilir; aynı alan adı her zaman çalışır.
ALLOWED_ORIGINS=https://haylazcafe.vercel.app

# Log ayrıntı düzeyi (isteğe bağlı): fatal, error, warn, info, debug, trace
LOG_LEVEL=info
